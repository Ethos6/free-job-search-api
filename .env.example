# Everything is optional. The defaults work.

# Public address of your API (used in alert feed links)
JOBS_BASE_URL=http://localhost:8000

# Web search: a FreeSearch API instance (docker-compose sets this for you)
# JOBS_SEARCH_URL=http://localhost:8001

# Optional AI for smarter understanding and ranking: any OpenAI-compatible API.
# Free and local with Ollama:  JOBS_LLM_URL=http://host.docker.internal:11434/v1  JOBS_LLM_MODEL=llama3.1
# JOBS_LLM_URL=
# JOBS_LLM_MODEL=llama3.1
# JOBS_LLM_KEY=

# Protect a public server: require one of these keys (X-API-Key header)
# JOBS_API_KEYS=change-me-1,change-me-2
JOBS_RATE_LIMIT=20

# Behind a reverse proxy (Caddy, nginx, Cloudflare Tunnel)
JOBS_TRUST_PROXY=0

# Your own company boards to index, e.g. greenhouse:acme,lever:example,ashby:startup
# JOBS_COMPANIES=

# LinkedIn guest pages and job pages on Indeed, Glassdoor etc. Their terms forbid automated
# access, so this is OFF unless you turn it on and accept that responsibility. See README.
JOBS_ENABLE_BIG_SITES=0
